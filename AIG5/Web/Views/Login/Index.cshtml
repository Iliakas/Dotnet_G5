@model LoginViewModel


@{
    Layout = null;
}



<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatAI - Connexion</title>
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: linear-gradient(135deg, #3446ed, #17105b, #7139ed);
                padding: 30px;
            }

            .container {
                width: 1200px;
                max-width: 100%;
                min-height: 750px;
                display: flex;
                background: white;
                border-radius: 30px;
                overflow: hidden;
                box-shadow: 0 25px 70px rgba(0,0,0,0.3);
            }

            /* LEFT PANEL */

            .left-panel {
                width: 48%;
                background: linear-gradient(145deg, #050b35, #101b72, #080d35);
                color: white;
                padding: 50px;
                display: flex;
                flex-direction: column;
                position: relative;
                justify-content: space-between;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 15px;
            }

                .logo h1 {
                    font-size: 38px;
                }

                    .logo h1 span {
                        color: #774cff;
                    }

            .logo-icon {
                font-size: 45px;
                color: #36c9ff;
            }

            .intro {
                text-align: center;
                margin-top: 50px;
            }

                .intro h2 {
                    font-size: 27px;
                    margin-bottom: 15px;
                }

                .intro p {
                    color: #c5c9ee;
                    line-height: 1.8;
                }

            .robot {
                font-size: 160px;
                text-align: center;
                margin: 20px 0;
                filter: drop-shadow(0 0 25px #385aff);
            }

            .features {
                display: flex;
                flex-direction: column;
                gap: 20px;
                font-size: 16px;
                color: #d9dcff;
            }

            /* RIGHT PANEL */

            .right-panel {
                width: 52%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 45px;
                background: #fff;
            }

            .login-box {
                width: 100%;
                max-width: 500px;
                text-align: center;
            }

            .robot-icon {
                font-size: 65px;
                margin-bottom: 15px;
            }

            .login-box h2 {
                font-size: 30px;
                color: #10152f;
                margin-bottom: 10px;
            }

                .login-box h2 span {
                    color: #5838f5;
                }

            .subtitle {
                color: #70758b;
                font-size: 14px;
                margin-bottom: 40px;
            }

            /* INPUTS */

            .input-group {
                width: 100%;
                height: 60px;
                border: 1px solid #d5d8e5;
                border-radius: 12px;
                display: flex;
                align-items: center;
                padding: 0 18px;
                margin-bottom: 20px;
                transition: 0.3s;
            }

                .input-group:focus-within {
                    border-color: #603cff;
                    box-shadow: 0 0 10px rgba(96,60,255,0.15);
                }

                .input-group span {
                    font-size: 20px;
                    margin-right: 15px;
                }

                .input-group input {
                    border: none;
                    outline: none;
                    width: 100%;
                    font-size: 16px;
                    color: #222;
                }

                    .input-group input::placeholder {
                        color: #999;
                    }

            /* OPTIONS */

            .options {
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 13px;
                margin: 25px 0;
                gap: 10px;
            }

                .options label {
                    color: #333;
                }

                .options a {
                    color: #593cff;
                    text-decoration: none;
                }

            /* LOGIN BUTTON */

            .login-btn {
                width: 100%;
                height: 62px;
                border: none;
                border-radius: 12px;
                background: linear-gradient(90deg, #4933f5, #8238f5);
                color: white;
                font-size: 17px;
                font-weight: 600;
                cursor: pointer;
                transition: 0.3s;
            }

                .login-btn:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 10px 25px rgba(83,55,240,0.3);
                }

            /* SEPARATOR */

            .separator {
                display: flex;
                align-items: center;
                gap: 15px;
                margin: 30px 0;
                color: #777;
            }

                .separator span {
                    flex: 1;
                    height: 1px;
                    background: #ddd;
                }

            /* GOOGLE */

            .google-btn {
                width: 100%;
                height: 60px;
                background: white;
                border: 1px solid #d5d8e5;
                border-radius: 12px;
                font-size: 16px;
                font-weight: 500;
                cursor: pointer;
                transition: 0.3s;
            }

                .google-btn strong {
                    color: #4285F4;
                    font-size: 22px;
                    margin-right: 12px;
                }

                .google-btn:hover {
                    background: #f7f7ff;
                    border-color: #603cff;
                }

            /* REGISTER */

            .register {
                margin-top: 35px;
                font-size: 14px;
                color: #333;
            }

                .register a {
                    color: #593cff;
                    font-weight: 600;
                    text-decoration: none;
                    margin-left: 5px;
                }

                    .register a:hover,
                    .options a:hover {
                        text-decoration: underline;
                    }

            /* RESPONSIVE */

            @@media (max-width: 850px) {

                body {
                    padding: 15px;
                }

                .container {
                    flex-direction: column;
                }

                .left-panel {
                    width: 100%;
                    min-height: 300px;
                    padding: 30px;
                }

                .robot {
                    font-size: 90px;
                    margin: 10px;
                }

                .intro {
                    margin-top: 20px;
                }

                .features {
                    display: none;
                }

                .right-panel {
                    width: 100%;
                    padding: 35px 25px;
                }
            }

            @@media (max-width: 480px) {

                .left-panel {
                    min-height: 240px;
                }

                .intro h2 {
                    font-size: 21px;
                }

                .robot {
                    font-size: 65px;
                }

                .login-box h2 {
                    font-size: 23px;
                }

                .options {
                    font-size: 11px;
                }

                .register {
                    font-size: 12px;
                }
            }

    </style>

</head>

<body>

    <div class="container">

        <!-- Partie gauche -->
        <div class="left-panel">

            <div class="logo">
                <span class="logo-icon">✦</span>
                <h1>Chat<span>AI</span></h1>
            </div>

            <div class="intro">
                <h2>Votre assistant intelligent</h2>
                <p>
                    Découvrez une nouvelle façon de communiquer
                    avec l'intelligence artificielle.
                </p>
            </div>

            <div class="robot">
                🤖
            </div>

            <div class="features">
                <p>⚡ Réponses instantanées</p>
                <p>🛡️ Sécurisé et fiable</p>
                <p>✦ Une IA puissante pour vous aider</p>
            </div>

        </div>


        <!-- Partie droite -->
        <div class="right-panel">

            <div class="login-box">

                <div class="robot-icon">🤖</div>

                <h2>Bienvenue au <span>G5</span></h2>

                <p class="subtitle">
                    Connectez-vous pour accéder à votre chatbot IA
                </p>

                <form asp-action="Index" asp-controller="">

                    <div class="input-group">
                        <span>✉</span>
                        <input type="email"
                               name="Login"
                               placeholder="Adresse email"
                               required>
                    </div>

                    <div class="input-group">
                        <span>🔒</span>
                        <input type="password"
                               name="Password"
                               placeholder="Mot de passe"
                               required>
                    </div>

                    <div class="options">
                        <label>
                            <input type="checkbox" name="remember">
                            Se souvenir de moi
                        </label>

                        <a href="#">Mot de passe oublié ?</a>
                    </div>

                    <button type="submit" class="login-btn">
                        ↪ Se connecter
                    </button>

                </form>

                <div class="separator">
                    <span></span>
                    <p>ou</p>
                    <span></span>
                </div>

                <button class="google-btn" type="button">
                    <strong>G</strong>
                    Continuer avec Google
                </button>

                <div class="register">
                    Vous n'avez pas de compte ?
                    <a href="#">Créer un compte</a>
                </div>

            </div>

        </div>

    </div>

</body>
</html>
